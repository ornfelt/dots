# Opens the calendar in the top right corner of the monitor under the mouse,
# 10px below the bar and the right screen edge (see sb-popup-pos)
calendar() {
	local width=260 pos
	if pos=$("${0%/*}/sb-popup-pos" "$width" right); then
		set -- $pos
		yad --calendar --no-buttons --width="$width" --posx="$1" --posy="$2"
	else
		yad --calendar --no-buttons --mouse
	fi
}

