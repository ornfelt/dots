+        warn   = "#E39B3A",
+        crit   = "#C8442E",
+        error  = "#9C9A93",
+    },
+
+    popup_placement = function(d)
+        claude_popup = d
+        claude_place_under_mouse(d, true)  -- also runs when the popup content resizes
+        if not claude_follow_timer.started then
