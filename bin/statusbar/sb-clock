# Opens the calendar in the top right corner of the monitor under the mouse, at
# the same offset as dunst's notifications (10px from the right, 50px from the top)
calendar() {
	local width=260 border=3 X Y SCREEN WINDOW geom
	eval "$(xdotool getmouselocation --shell)"
	geom=$(xrandr --listactivemonitors | awk -v x="$X" -v y="$Y" 'NR > 1 {
		split($3, g, "[/x+]")  # 1920/309x1080/173+0+0
		if (x >= g[5] && x < g[5] + g[1] && y >= g[6] && y < g[6] + g[3]) { print g[5] + g[1], g[6]; exit }
	}')
	if [ -z "$geom" ]; then
		yad --calendar --no-buttons --mouse
		return
	fi
	set -- $geom
	yad --calendar --no-buttons --width="$width" \
		--posx=$(($1 - width - 2 * border - 10)) --posy=$(($2 + 50))
}

