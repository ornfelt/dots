+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v7
+      - uses: leafo/gh-actions-lua@v13
+        with:
+          luaVersion: "5.4"
+      - uses: leafo/gh-actions-luarocks@v6.1.0
+      - run: luarocks install luacheck
+      - run: luacheck .
+
+  test:
+    name: Test (${{ matrix.lua }})
+    runs-on: ubuntu-latest
+    strategy:
+      fail-fast: false
+      matrix:
+        lua: ["5.4", "luajit-2.1"]
+    steps:
+      - uses: actions/checkout@v7
+      - uses: leafo/gh-actions-lua@v13
+        with:
+          luaVersion: ${{ matrix.lua }}
+      - run: TZ=UTC lua spec/run.lua
+      - run: TZ=Europe/Vienna lua spec/run.lua
+      - run: sh -n contrib/statusline-cache.sh
