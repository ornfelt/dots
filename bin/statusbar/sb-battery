# Icon for a status and capacity, like awesome's battery widget used: full,
# charging, else by the level (80/60/40/20)
bat_icon() {
    if [ "$1" = "full" ]; then
        icon=$ICON_BAT_4
    elif [ "$1" = "charging" ]; then
        icon=$ICON_BAT_CHARGING
    elif [ "$2" -ge 80 ]; then
        icon=$ICON_BAT_4
    elif [ "$2" -ge 60 ]; then
        icon=$ICON_BAT_3
    elif [ "$2" -ge 40 ]; then
        icon=$ICON_BAT_2
    elif [ "$2" -ge 20 ]; then
        icon=$ICON_BAT_1
    else
        icon=$ICON_BAT_0
    fi
}

# Demo (sb-demo): one battery, each icon as likely as the others, with a
# capacity that fits it
if sb_demo; then
    sb_pick 7
    case $SB_R in
        0) status=full lo=100 hi=100 ;;
        1) status=charging lo=0 hi=100 ;;
        2) status=discharging lo=80 hi=100 ;;
        3) status=discharging lo=60 hi=79 ;;
        4) status=discharging lo=40 hi=59 ;;
        5) status=discharging lo=20 hi=39 ;;
        *) status=discharging lo=0 hi=19 ;;
    esac
    sb_range "$lo" "$hi"
    bat_icon "$status" "$SB_R"
    sb_seg "$COLOR_BAT" "$icon" "$SB_R%"
    sb_print
    exit 0
fi

# Loop through all attached batteries and format the info, a part each
for battery in /sys/class/power_supply/BAT?*; do
    [ -r "$battery/capacity" ] || continue
    # Sets up the status and capacity
    case "$(cat "$battery/status")" in
        "Full") status="full" ;;
        "Discharging") status="discharging" ;;
        "Charging") status="charging" ;;
        "Not charging") status="not_charging" ;;
        "Unknown") status="unknown" ;;
    esac
    capacity=$(cat "$battery/capacity")
    
    # Ensure capacity is not 99, if so set it to 100
    if [ "$capacity" = "99" ]; then
        capacity=100
    fi

    # Testing
    #status="full"
    #status="discharging"
    #capacity="29"

    bat_icon "$status" "$capacity"
    sb_seg "$COLOR_BAT" "$icon" "$capacity%"
done
sb_print
exit 0
